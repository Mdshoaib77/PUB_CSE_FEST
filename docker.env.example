# Copy to .env (same folder as docker-compose.yml) before `docker compose up`.
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
QR_TOKEN_SECRET=

# Public address people use in the browser (CORS allow-list).
CLIENT_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Plain http (local): leave as is.  Behind HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Largest event cover image in MB (the nginx limit is 6 MB; raise both together).
MAX_IMAGE_MB=5
# Hide the demo-account chips on the login page in real deployments.
VITE_SHOW_DEMO=true

# Optional e-mail copies of notifications. Leave SMTP_HOST empty to disable (in-app notifications always work).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
