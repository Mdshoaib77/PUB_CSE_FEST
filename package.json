{
  "name": "stackforge-festhub",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @festhub/server",
    "dev:web": "npm run dev -w @festhub/web",
    "seed": "npm run seed -w @festhub/server",
    "seed:demo": "npm run seed:demo -w @festhub/server",
    "migrate": "npm run migrate -w @festhub/server",
    "sponsors:remind": "npm run sponsors:remind -w @festhub/server",
    "test": "npm run test -w @festhub/server && npm run test -w @festhub/web",
    "typecheck": "npm run typecheck -w @festhub/server && npm run typecheck -w @festhub/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "npm run build -w @festhub/server && npm run build -w @festhub/web",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "typescript-eslint": "^8.8.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "concurrently": "^9.0.1"
  }
}
