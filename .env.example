# FestHub — root environment template.
# Local dev: copy to apps/server/.env (the server loads it via dotenv).
# Docker: use docker.env.example -> .env instead (it sets most of these for you).

NODE_ENV=development
PORT=5000

# ---- Database (MongoDB) ----
MONGODB_URI=mongodb://127.0.0.1:27017/festhub
# Tests only (this database is dropped on every run)
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/festhub_test

# ---- Secrets (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me
QR_TOKEN_SECRET=change-me-too
QR_TOKEN_TTL_SEC=45

# ---- CORS / cookies ----
CLIENT_ORIGIN=http://localhost:5173
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# ---- Uploads ----
# UPLOAD_DIR=./uploads
# MAX_IMAGE_MB=5

# ---- Judge0 / contests ----
JUDGE_ADAPTER=judge0
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=placeholder
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_AUTH_TOKEN=
JUDGE0_POLL_MS=1000
JUDGE0_POLL_TIMEOUT_MS=30000
JUDGE_MAX_ATTEMPTS=3
SUBMISSION_COOLDOWN_SEC=10

# ---- Email / SMTP (optional, S3) ----
# Leave SMTP_HOST unset (or commented) to disable e-mail: in-app notifications keep working and nothing is attempted.
# When set, every notification is also e-mailed to the user; delivery failures are ignored silently (logged as a warning).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true = implicit TLS (port 465); false = STARTTLS when the server offers it
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="FestHub <no-reply@festhub.test>"
# SMTP_TIMEOUT_MS=10000
# APP_URL=http://localhost:5173   # base address for links inside e-mails (defaults to the first CLIENT_ORIGIN)

# ---- AI feedback (S13) ----
# Key and model come ONLY from these env vars. Leave either empty = AI feedback disabled (app runs normally; manual feedback still works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional tuning: ANTHROPIC_TIMEOUT_MS=60000  ANTHROPIC_MAX_RETRIES=3  ANTHROPIC_MAX_INPUT_CHARS=24000  ANTHROPIC_MAX_OUTPUT_TOKENS=2000

# ---- Web (apps/web/.env; leave empty in dev to use the Vite proxy) ----
# VITE_API_BASE_URL=
# VITE_SOCKET_URL=

# ---- Certificates (S5) ----
# CERT_SIGNATURE_TEXT="Organizing Committee, PUB FestHub"   # printed under the signature line (ASCII/Latin-1 only)
