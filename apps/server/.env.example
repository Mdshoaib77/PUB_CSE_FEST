NODE_ENV=development
PORT=5000
# MongoDB (Atlas SRV string in production)
MONGODB_URI=mongodb://127.0.0.1:27017/festhub
# Secrets: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me
QR_TOKEN_SECRET=change-me-too
# Comma-separated list of allowed browser origins (CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Judge engine: judge0 (production) | mock (automated tests only; refused when NODE_ENV=production)
JUDGE_ADAPTER=judge0
# Judge0 – server-side only, never exposed to the browser
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=placeholder
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
# For self-hosted Judge0 with authentication enabled, use this instead of the RapidAPI pair
JUDGE0_AUTH_TOKEN=
# Optional overrides
# Judge0 CE 1.13.x ids (defaults). Check yours with GET /api/v1/judge/languages as an organiser.
JUDGE0_LANGUAGE_IDS={"c":50,"cpp":54,"java":62,"python":71,"javascript":63,"typescript":74,"go":60,"csharp":51,"rust":73,"php":68}
JUDGE0_POLL_MS=1000
JUDGE0_POLL_TIMEOUT_MS=30000
JUDGE_MAX_ATTEMPTS=3
SUBMISSION_COOLDOWN_SEC=10
# Tests only: separate database
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/festhub_test
# Optional e-mail copies of notifications (S3). Unset SMTP_HOST = disabled; failures are ignored silently.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="FestHub <no-reply@festhub.test>"
# APP_URL=http://localhost:5173
# Check-in QR lifetime in seconds (the web client refreshes it automatically)
QR_TOKEN_TTL_SEC=45

# Event cover images: where uploads are stored and the size limit (MB)
# UPLOAD_DIR=./uploads
# MAX_IMAGE_MB=5
# Refresh cookie (defaults: Secure+SameSite=None in production, Lax in development)
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
