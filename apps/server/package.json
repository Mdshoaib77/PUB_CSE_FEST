{
  "name": "@festhub/server",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --packages=external --alias:@festhub/shared=../../packages/shared/src/index.ts --format=cjs --outfile=dist/index.js",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/seed.ts",
    "seed:demo": "tsx src/seed/demo-run.ts",
    "migrate": "tsx src/migrate.ts",
    "sponsors:remind": "tsx src/sponsorReminders-run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@festhub/shared": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.0",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.2"
  }
}
